     ========================================================= */

  function normalizeSpeed(value) {
    const numeric = Number(value);

    if (!Number.isFinite(numeric))
      return cfg.speed;

    return Math.max(
      MIN_SPEED,
      Math.min(MAX_SPEED, Math.round(numeric))
    );
  }

  function speedToSlider(speed) {
    const s = Math.max(
      MIN_SPEED,
      Math.min(MAX_SPEED, Number(speed))
    );

    return Math.round(
      Math.log(s / MIN_SPEED) /
      Math.log(MAX_SPEED / MIN_SPEED) *
      SPEED_SLIDER_MAX
    );
  }

  function sliderToSpeed(position) {
    const p = Math.max(
      0,
      Math.min(SPEED_SLIDER_MAX, Number(position))
    );

    const normalized = p / SPEED_SLIDER_MAX;

    return Math.round(
      MIN_SPEED *
      Math.pow(
        MAX_SPEED / MIN_SPEED,
        normalized
      )
    );
  }

  function formatSpeed(speed) {
    return Number(speed).toLocaleString();
  }

  function setSpeed(value) {
    cfg.speed = normalizeSpeed(value);

    extraStepAccumulator = 0;

    syncControls();
    save();
  }

