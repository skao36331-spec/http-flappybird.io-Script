  /* =========================================================
     GAME ATTACHMENT
     ========================================================= */

  function attachGame() {

    const candidate = window.__game;

    if (
      !candidate ||
      typeof candidate.step !== 'function' ||
      typeof candidate.flap !== 'function'
    ) {
      return false;
    }

    if (candidate === game)
      return true;

    if (
      game &&
      originalStep &&
      game.step !== originalStep
    ) {
      game.step = originalStep;
    }

    if (
      game &&
      originalTransition
    ) {
      game.transition = originalTransition;
    }

    game = candidate;

    originalStep = game.step;
    originalTransition = game.transition;
    originalNetMode = game.netMode;

    game.step = function ggalex69Step(dt) {

      if (cfg.localOnly)
        this.ranked = false;

      if (
        cfg.autopilot &&
        !document.hidden &&
        (
          this.state === 'play' ||
          this.snapshot?.state === 'play'
        ) &&
        wantsFlap(this)
      ) {
        this.flap();
        flapCount++;
      }

      return originalStep.call(this, dt);
    };

    game.transition = function patchedTransition(nextState) {

      if (
        nextState === 'gameover' &&
        cfg.godMode
      ) {

        const snap = this.snapshot;

        const pipe =
          snap.pipes.find(
            p =>
              !p.passed &&
              p.x > -0.15
          );

        this.birdY =
          Math.round(
            (pipe ? pipe.gapY : 0) *
            FIXED_SCALE
          );

        this.prevBirdY = this.birdY;
        this.birdVy = 0;
        this.deathCause = null;

        this.flap();

        flapCount++;

        return;
      }

      return originalTransition.call(
        this,
        nextState
      );
    };

    applySafetyMode();

    return true;
  }

  function applySafetyMode() {
    if (!game)
      return;

    game.netMode = 'offline';
    game.ranked = false;
  }

  /* =========================================================
     AUTOPILOT
     ========================================================= */

  function wantsFlap(activeGame) {

    const snapshot = activeGame.snapshot;

    if (
      !snapshot ||
      !Array.isArray(snapshot.pipes)
    ) {
      return false;
    }

    const y =
      Number(activeGame.birdY) /
      FIXED_SCALE;

    const velocity =
      Number(activeGame.birdVy) /
      FIXED_SCALE;

    if (
      !Number.isFinite(y) ||
      !Number.isFinite(velocity)
    ) {
      return false;
    }

    const pipes =
      snapshot.pipes
        .filter(
          pipe =>
            Number.isFinite(pipe.x) &&
            pipe.x > -0.205
        )
        .sort(
          (a,b) =>
            a.x - b.x
        );

    const current = pipes[0];

    if (!current) {

      nextPipeX = null;

      targetY =
        0.15 +
        cfg.aimBias;

    } else {

      const next = pipes[1];

      targetY =
        current.gapY -
        0.095 +
        cfg.aimBias;

      nextPipeX =
        current.x;

      if (
        next &&
        current.x < 0.30
      ) {

        const safeLow =
          current.gapY -
          current.halfGap +
          0.105;

        const safeHigh =
          current.gapY +
          current.halfGap -
          0.33;

        const nextTarget =
          next.gapY -
          0.095 +
          cfg.aimBias;

        targetY =
          Math.max(
            safeLow,
            Math.min(
              safeHigh,
              nextTarget
            )
          );
      }
    }

    const predictedY =
      y +
      velocity * 0.025 -
      2.5 * 0.025 ** 2;

    return (
      velocity <= 0.05 &&
      predictedY < targetY
    );
  }

  /* =========================================================
     ROUND MANAGEMENT
     ========================================================= */

  function manageRoundState() {

    if (!game)
      return;

    const snapshot =
      game.snapshot;

    if (!snapshot)
      return;

    const state =
      game.state ||
      snapshot.state;

    if (state === 'getready') {

      if (cfg.localOnly) {
        game.netMode = 'offline';
        game.ranked = false;
      }

      if (cfg.autopilot) {
        game.flap();
        flapCount++;
      }

      return;
    }

    if (state === 'gameover') {

      const elapsed =
        snapshot.stateElapsed ??
        game.stateElapsed ??
        1;

      if (
        cfg.autoRestart &&
        elapsed > 0.72 &&
        typeof game.restart === 'function'
      ) {
        game.restart();
      }

      return;
    }
  }

  /* =========================================================
     STATS
     ========================================================= */

  function updateStats(now) {

    if (
      !game ||
      now - lastStatsAt < 180
    ) {
      return;
    }

    const snapshot =
      game.snapshot;

    if (!snapshot)
      return;

    const elapsed =
      (now - lastStatsAt) /
      1000;

    const rate =
      (simulatedSteps - displayedSteps) /
      SIM_HZ /
      elapsed;

    const score =
      Number(
        snapshot.score ??
        game.score ??
        0
      );

    sessionBest =
      Math.max(
        sessionBest,
        score
      );

    displayedSteps =
      simulatedSteps;

    lastStatsAt =
      now;

    const state =
      snapshot.state ||
      game.state ||
      'wait';

    const isPlaying =
      state === 'play';

    stat('state').textContent =
      isPlaying
        ? 'Flying'
        : state.charAt(0).toUpperCase() +
          state.slice(1);

    stat('state').className =
      isPlaying
        ? 'fd-state-live'
        : 'fd-state-warn';

    stat('score').textContent =
      score.toLocaleString();

    stat('best').textContent =
      sessionBest.toLocaleString();

    stat('flaps').textContent =
      flapCount.toLocaleString();

    stat('rate').innerHTML =
      `${Math.max(
        1,
        Math.round(rate + 1)
      ).toLocaleString()}&times;`;
  }

  /* =========================================================
     HIGH-SPEED SIMULATION
     ========================================================= */

  function getStepBudget(speed) {

    if (speed <= 250)
      return 1500;

    if (speed <= 1000)
      return 4000;

    if (speed <= 2500)
      return 8000;

    if (speed <= 5000)
      return 12000;

    return 18000;
  }

  function loop(now) {

    if (destroyed)
      return;

    attachGame();

    const deltaSeconds =
      Math.min(
        0.05,
        Math.max(
          0,
          (now - lastFrameAt) /
          1000
        )
      );

    lastFrameAt = now;

    if (game) {

      manageRoundState();

      /*
       * The page itself provides approximately the
       * first 1x simulation rate.
       *
       * FlightDeck supplies the remaining fixed
       * simulation steps.
       */

      const requestedSteps =
        deltaSeconds *
        SIM_HZ *
        Math.max(
          0,
          cfg.speed - 1
        );

      extraStepAccumulator +=
        requestedSteps;

      /*
       * Avoid enormous catch-up queues if Chrome
       * pauses the tab or DevTools stalls.
       */

      const MAX_BACKLOG = 250000;

      if (
        extraStepAccumulator >
        MAX_BACKLOG
      ) {
        extraStepAccumulator =
          MAX_BACKLOG;
      }

      const stepBudget =
        getStepBudget(cfg.speed);

      const extraSteps =
        Math.min(
          stepBudget,
          Math.floor(
            extraStepAccumulator
          )
        );

      extraStepAccumulator -=
        extraSteps;

      for (
        let i = 0;
        i < extraSteps;
        i++
      ) {
        game.step(GAME_STEP);
      }

      simulatedSteps +=
        extraSteps;

      updateStats(now);

    } else {

      stat('state').textContent =
        'Waiting';

      stat('state').className =
        'fd-state-warn';
    }

    frameId =
      requestAnimationFrame(loop);
  }

  /* =========================================================
     HOTKEYS
     ========================================================= */

  function onKey(event) {

    if (event.repeat)
      return;

    if (event.code === 'F2') {

      event.preventDefault();

      cfg.autopilot =
        !cfg.autopilot;

    }

    else if (event.code === 'F3') {

      event.preventDefault();

      const next =
        SPEEDS.find(
          speed =>
            speed > cfg.speed
        ) ??
        SPEEDS[0];

      setSpeed(next);

      return;
    }

    else if (event.code === 'F4') {

      event.preventDefault();

      cfg.autoRestart =
        !cfg.autoRestart;

    }

    else if (event.code === 'F5') {

      event.preventDefault();

      cfg.godMode =
        !cfg.godMode;

    }

    else if (event.code === 'F6') {

      event.preventDefault();

      cfg.hidden =
        !cfg.hidden;

    }

    else if (event.code === 'F8') {

      event.preventDefault();

      api.destroy();

      return;
    }

    else {
      return;
    }

    syncControls();
    save();
  }

  window.addEventListener(
    'keydown',
    onKey,
    true
  );

  /* =========================================================
     PUBLIC API / CLEANUP
     ========================================================= */

  const api =
    window.__ggalex69 = {

